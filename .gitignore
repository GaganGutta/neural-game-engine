__pycache__/
*.py[cod]
.venv/
venv/
.env
.pytest_cache/

# VizDoom drops this next to whatever launched it.
_vizdoom.ini
_vizdoom/

# Datasets and training runs are rebuilt by the pipeline, never committed.
# Anchored with a leading slash: a bare `data/` also matches `ngx/data/`, which
# silently kept the entire data package out of the repo.
/data/
/runs/
*.npy
*.ckpt

# ...but the two weights that make `python play.py` work from a clone are.
*.pt
!checkpoints/**/*.pt

# ...but the README's demo media is part of the repo.
!assets/*.gif
!assets/*.png

# one-off repair scripts and run logs
repair2m.py
*.log
